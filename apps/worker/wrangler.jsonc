{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sharehtml-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "AUTH_MODE": "none"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/d/*", "/api/*", "/docs/*", "/health", "/"]
  },
  "r2_buckets": [
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "sharehtml-documents-dev"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCUMENT_DO",
        "class_name": "DocumentDO"
      },
      {
        "name": "REGISTRY_DO",
        "class_name": "RegistryDO"
      }
    ]
  },
  // Workers Rate Limiting binding; limits are per key per Cloudflare location.
  "ratelimits": [
    { "name": "UPLOAD_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "VIEW_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
    { "name": "WS_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "COMMENT_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
    { "name": "REPORT_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 5, "period": 60 } }
  ],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocumentDO", "RegistryDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": []
    },
    {
      "tag": "v3",
      "new_sqlite_classes": []
    }
  ],
  "env": {
    "production": {
      "name": "sharehtml",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "html.duyet.net",
          "custom_domain": true
        }
      ],
      "preview_urls": false,
      "upload_source_maps": true,
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": true
        }
      },
      "vars": {
        "AUTH_MODE": "clerk",
        "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaHRtbC5kdXlldC5uZXQk",
        "VIEWER_CAPABILITY_SECRET": "clerk-prod-viewer-capability-secret-v1-20260509"
      },
      "assets": {
        "directory": "dist/client",
        "not_found_handling": "none",
        "binding": "ASSETS",
        "run_worker_first": ["/d/*", "/api/*", "/docs/*", "/health", "/"]
      },
      "r2_buckets": [
        {
          "binding": "DOCUMENTS_BUCKET",
          "bucket_name": "sharehtml-documents"
        }
      ],
      "ratelimits": [
        { "name": "UPLOAD_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "WRITE_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "VIEW_RATE_LIMITER", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } },
        { "name": "WS_RATE_LIMITER", "namespace_id": "2004", "simple": { "limit": 30, "period": 60 } },
        { "name": "COMMENT_RATE_LIMITER", "namespace_id": "2005", "simple": { "limit": 20, "period": 60 } },
        { "name": "REPORT_RATE_LIMITER", "namespace_id": "2006", "simple": { "limit": 5, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DOCUMENT_DO",
            "class_name": "DocumentDO"
          },
          {
            "name": "REGISTRY_DO",
            "class_name": "RegistryDO"
          }
        ]
      }
    }
  }
}
